# Copy this file to `.env` in the same directory and set the value for
# local development. Never commit `.env` itself — only this example file
# with a placeholder value belongs in version control.
#
# The `EXPO_PUBLIC_` prefix is required: Expo only inlines environment
# variables with this prefix into the app bundle. Do not put secrets in
# an EXPO_PUBLIC_* variable — anything with this prefix ships inside the
# client bundle and is readable by anyone who has the app.
#
# Base URL of the Karmanya backend. For a physical device or simulator,
# `localhost` will not reach a backend running on your development
# machine — use your machine's LAN IP instead (e.g. http://192.168.1.23:8000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
