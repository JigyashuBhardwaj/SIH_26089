# Copy this file to `.env` in the same directory and set the value for
# local development. Never commit `.env` itself — only this example file
# with a placeholder value belongs in version control.
#
# The `VITE_` prefix is required: Vite only exposes environment variables
# with this prefix to client code (via import.meta.env). Do not put
# secrets in a VITE_* variable — anything with this prefix ships inside
# the browser bundle.
#
# Base URL of the Karmanya backend.
VITE_API_BASE_URL=http://localhost:8000
