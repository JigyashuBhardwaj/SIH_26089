# Copy this file to `.env` in the same directory and fill in real values
# for local development. Never commit `.env` itself — only this example
# file with placeholder values belongs in version control.

# "development" or "production". Informational only at this stage.
APP_ENV=development

# PostgreSQL connection string.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# There is no default/fallback in code — this must be set for the app to
# start, so a real password can never end up hardcoded in source.
DATABASE_URL=postgresql+psycopg://karmanya:karmanya@localhost:5432/karmanya

# Comma-separated list of allowed CORS origins. Defaults (in code, if this
# is omitted) cover the existing mobile (Expo) and admin (Vite) dev
# servers already used elsewhere in this project.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Phase 5D — JWT authentication.

# Secret key used to sign/verify access tokens (HS256). There is no
# default/fallback in code — this must be set for the app to start, so a
# real signing secret can never end up hardcoded in source. Generate a
# strong random value for real environments, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-value-for-local-dev-only

# Minutes an issued access token stays valid. Optional — defaults to 30
# in code if omitted.
ACCESS_TOKEN_EXPIRE_MINUTES=30
