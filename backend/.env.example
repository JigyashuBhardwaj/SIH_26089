# Copy this file to `.env` in the same directory and fill in real values
# for local development. Never commit `.env` itself — only this example
# file with placeholder values belongs in version control.

# "development" or "production". Informational only at this stage.
APP_ENV=development

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# There is no default/fallback in code — this must be set for the app to
# start, so a real password can never end up hardcoded in source.
DATABASE_URL=postgresql://karmanya:karmanya@localhost:5432/karmanya

# Comma-separated list of allowed CORS origins. Defaults (in code, if this
# is omitted) cover the existing mobile (Expo) and admin (Vite) dev
# servers already used elsewhere in this project.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
